<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Candy Quest SKI — Kelas 7 Semester 2</title>
<style>
:root{--pink:#ff5da8;--purple:#8d5cf6;--ink:#3c2852;--muted:#806b91;--cream:#fff9fc}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top left,#ffe0ef,transparent 36%),linear-gradient(135deg,#fff8e9,#f0e7ff 65%,#e2fbff);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);min-height:100vh}.wrap{max-width:1040px;margin:auto;padding:20px}.hero{text-align:center;margin:8px 0 18px}.logo{font-size:clamp(2rem,6vw,3.5rem);font-weight:1000;letter-spacing:-2px;color:#f04d9b;text-shadow:2px 3px #ffd0e5}.hero p{margin:4px 0;color:var(--muted)}.tag{display:inline-block;border-radius:99px;background:#fff;padding:6px 12px;font-size:.8rem;font-weight:800;color:#8656c8;border:1px solid #f2d8ff}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.stat,.panel{background:#ffffffdf;border:2px solid #fff;border-radius:20px;padding:14px;box-shadow:0 8px 24px #6b3d8112}.stat span{display:block;font-size:.78rem;color:var(--muted)}.stat strong{font-size:1.25rem}.layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(270px,.85fr);gap:16px;align-items:start}.panel h2{margin:0 0 10px;font-size:1.15rem}.hint{font-size:.86rem;color:var(--muted);line-height:1.55}.board{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px;background:#e6d9ff;padding:8px;border-radius:17px;touch-action:manipulation}.candy{aspect-ratio:1;border:0;border-radius:12px;display:grid;place-items:center;font-size:clamp(1.05rem,4vw,2rem);cursor:pointer;background:linear-gradient(145deg,#fff,#f5eaff);box-shadow:inset 0 -4px #cdb8ee;transition:transform .12s;min-width:0}.candy:hover{transform:translateY(-2px)}.candy.selected{outline:3px solid #ff4f9b;transform:scale(.9)}.candy.empty{visibility:hidden}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.action{border:0;border-radius:13px;padding:11px 14px;background:linear-gradient(135deg,#ff68a7,#a76cff);color:white;font-weight:800;cursor:pointer;box-shadow:0 4px 0 #d8b6f2}.action.secondary{background:#f2e8ff;color:#76519b;box-shadow:none}.action:disabled{opacity:.5;cursor:not-allowed}.side{display:grid;gap:14px}.notice{min-height:46px;padding:10px 12px;border-radius:13px;background:#fff0f8;font-size:.9rem;line-height:1.45}.target{font-weight:850;color:#8b54d7}.progress{height:12px;background:#f0e5fa;border-radius:99px;overflow:hidden;margin:8px 0 14px}.bar{height:100%;width:0;background:linear-gradient(90deg,#ff68a7,#a879ff);transition:width .3s}.quiz{display:none}.quiz.show{display:block}.qtext{font-weight:850;font-size:1.05rem;line-height:1.5}.options{display:grid;gap:8px;margin:13px 0}.option{padding:11px;border:2px solid #e8d9fa;background:white;border-radius:12px;text-align:left;font-weight:700;color:var(--ink);cursor:pointer}.option:hover{border-color:#ff77ae}.option.correct{background:#d9ffe9;border-color:#35b878}.option.wrong{background:#ffe0e8;border-color:#ff668a}.result{font-weight:800;min-height:25px;line-height:1.4}.tiny{font-size:.78rem;color:var(--muted)}.footer{text-align:center;color:#927da4;font-size:.8rem;margin:20px}.overlay{display:none;position:fixed;inset:0;background:#38224fc9;z-index:5;align-items:center;justify-content:center;padding:20px}.overlay.show{display:flex}.modal{background:white;max-width:420px;width:100%;border-radius:25px;padding:26px;text-align:center;box-shadow:0 20px 60px #25143b55}.modal .big{font-size:3.5rem}.modal p{line-height:1.5;color:var(--muted)}
@media(max-width:720px){.wrap{padding:12px}.layout{grid-template-columns:1fr}.stats{gap:6px}.stat{padding:9px}.stat strong{font-size:1rem}.stat span{font-size:.7rem}.board{gap:4px;padding:6px}.candy{border-radius:8px}}
</style>
</head>
<body><div class="wrap">
<header class="hero"><div class="logo">🍬 CANDY QUEST</div><p>Petualangan permen sambil belajar Sejarah Kebudayaan Islam</p><div class="tag">📚 SKI • Kelas VII • Semester 2</div></header>
<section class="stats">
<div class="stat"><span>🌟 LEVEL</span><strong id="level">1</strong></div><div class="stat"><span>🍭 POIN</span><strong id="score">0</strong></div><div class="stat"><span>💖 LANGKAH</span><strong id="moves">20</strong></div><div class="stat"><span>🏆 BINTANG</span><strong id="stars">0</strong></div>
</section>
<main class="layout">
<section class="panel"><h2>🍬 Papan Permen</h2><p class="hint">Pilih satu permen, lalu pilih permen di sebelahnya untuk menukar posisi. Cocokkan 3 atau lebih permen yang sama agar mendapat poin.</p><div class="board" id="board"></div><div class="actions"><button class="action" id="shuffle">🔀 Acak papan</button><button class="action secondary" id="restart">↻ Ulangi level</button></div></section>
<aside class="side">
<section class="panel"><h2>🎯 Misi Level</h2><div class="target" id="targetText">Raih 300 poin!</div><div class="progress"><div class="bar" id="bar"></div></div><div class="notice" id="message">Cocokkan permen untuk mengumpulkan poin. Setelah target tercapai, jawab soal SKI!</div></section>
<section class="panel quiz" id="quiz"><h2>🧠 Tantangan SKI!</h2><p class="hint">Jawab soal Sejarah Kebudayaan Islam dengan benar untuk membuka level berikutnya.</p><div id="question" class="qtext"></div><div class="options" id="options"></div><div class="result" id="result"></div><button class="action" id="next" style="display:none;width:100%">🚀 Level Berikutnya</button><div class="tiny" style="margin-top:8px">Materi mengikuti tema umum SKI kelas VII; urutan dan cakupan bisa berbeda sesuai buku/madrasah.</div></section>
<section class="panel"><h2>📖 Cara Naik Level</h2><div class="hint">• Kumpulkan poin dari kecocokan permen.<br>• Capai target poin pada level ini.<br>• Jawab soal SKI dengan benar.<br>• Jawaban benar mendapat 1 bintang dan membuka level berikutnya.<br>• Langkah habis? Tekan “Ulangi level”.</div></section>
</aside></main><div class="footer">Belajar sejarah jadi petualangan! 🌙✨</div></div>
<script>
const SIZE=8, candies=['🍓','🍋','🍇','🍊','🍬','🫐'];
// Soal pilihan ganda SKI kelas VII: tema dakwah Nabi di Madinah, Khulafaur Rasyidin, dan perkembangan Islam awal.
const questions=[
{q:'Peristiwa hijrahnya Nabi Muhammad saw. dari Makkah ke Yatsrib menjadi awal penanggalan…',a:['Masehi','Hijriah','Jawa','Saka'],c:1},
{q:'Nama kota Yatsrib setelah Nabi Muhammad saw. hijrah dikenal sebagai…',a:['Baghdad','Damaskus','Madinah','Kufah'],c:2},
{q:'Kaum Muslim dari Makkah yang berhijrah ke Madinah disebut…',a:['Ansar','Muhajirin','Tabiin','Quraisy'],c:1},
{q:'Penduduk Madinah yang menolong kaum Muslim dari Makkah disebut…',a:['Muhajirin','Romawi','Ansar','Persia'],c:2},
{q:'Masjid yang dibangun Nabi Muhammad saw. ketika tiba di sekitar Madinah adalah…',a:['Masjid Quba','Masjidil Aqsa','Masjid Umayyah','Masjid Cordoba'],c:0},
{q:'Perjanjian yang mengatur kehidupan bersama berbagai kelompok di Madinah dikenal sebagai…',a:['Piagam Madinah','Perjanjian Hudaibiyah','Baiat Aqabah','Perjanjian Versailles'],c:0},
{q:'Sahabat yang menjadi khalifah pertama setelah Nabi Muhammad saw. wafat adalah…',a:['Umar bin Khattab','Ali bin Abi Thalib','Utsman bin Affan','Abu Bakar ash-Shiddiq'],c:3},
{q:'Khalifah kedua dalam Khulafaur Rasyidin adalah…',a:['Umar bin Khattab','Abu Bakar','Utsman bin Affan','Ali bin Abi Thalib'],c:0},
{q:'Khalifah yang dikenal berjasa dalam pembukuan dan penyeragaman mushaf Al-Qur’an adalah…',a:['Abu Bakar','Umar bin Khattab','Utsman bin Affan','Ali bin Abi Thalib'],c:2},
{q:'Khalifah keempat dalam Khulafaur Rasyidin adalah…',a:['Utsman bin Affan','Ali bin Abi Thalib','Abu Bakar','Umar bin Khattab'],c:1},
{q:'Salah satu tujuan hijrah Nabi Muhammad saw. ke Madinah adalah…',a:['Mencari harta sebanyak-banyaknya','Membangun masyarakat Islam yang aman','Menguasai seluruh perdagangan','Menghindari semua bentuk dakwah'],c:1},
{q:'Dua suku besar di Madinah yang sebelum Islam sering berselisih adalah…',a:['Aus dan Khazraj','Ad dan Tsamud','Quraisy dan Tsaqif','Romawi dan Persia'],c:0},
{q:'Sikap yang dapat diteladani dari persaudaraan Muhajirin dan Ansar adalah…',a:['Mementingkan diri sendiri','Saling menolong dan peduli','Membalas keburukan','Menolak pendatang'],c:1},
{q:'Khulafaur Rasyidin secara umum berarti…',a:['Para pedagang Makkah','Empat khalifah yang mendapat petunjuk','Pasukan dari Romawi','Para penulis wahyu saja'],c:1},
{q:'Khalifah yang mendapat julukan Al-Faruq adalah…',a:['Abu Bakar','Umar bin Khattab','Utsman bin Affan','Ali bin Abi Thalib'],c:1},
{q:'Perang Badar terjadi antara kaum Muslim dan kaum…',a:['Quraisy Makkah','Persia','Mongol','Andalusia'],c:0},
{q:'Perjanjian Hudaibiyah dilakukan antara kaum Muslim dan…',a:['Bangsa Romawi','Kaum Quraisy Makkah','Bangsa India','Penduduk Mesir'],c:1},
{q:'Sikap Nabi Muhammad saw. saat memasuki Makkah kembali menunjukkan…',a:['Kesombongan','Balas dendam','Pemaafan dan kerendahan hati','Keinginan memperkaya diri'],c:2},
{q:'Sumber utama ajaran Islam yang menjadi pedoman umat Muslim adalah…',a:['Al-Qur’an dan sunah','Legenda kerajaan saja','Pendapat pedagang','Tradisi bangsa lain saja'],c:0},
{q:'Pelajaran penting dari dakwah Nabi di Madinah adalah membangun masyarakat berdasarkan…',a:['Permusuhan','Persatuan, keadilan, dan saling menghormati','Perbedaan status semata','Persaingan tanpa aturan'],c:1}
];
let board=[],selected=null,score=0,level=1,moves=20,stars=0,locked=false,answered=false;
const $=id=>document.getElementById(id);
function target(){return 300+(level-1)*100}
function rand(){return Math.floor(Math.random()*candies.length)}
function createBoard(){board=Array.from({length:SIZE*SIZE},rand);for(let pass=0;pass<8;pass++){for(let r=0;r<SIZE;r++)for(let c=0;c<SIZE;c++){let i=r*SIZE+c;if((c>=2&&board[i]===board[i-1]&&board[i]===board[i-2])||(r>=2&&board[i]===board[i-SIZE]&&board[i]===board[i-2*SIZE]))board[i]=rand()}}selected=null;render()}
function render(){let el=$('board');el.innerHTML='';board.forEach((v,i)=>{let b=document.createElement('button');b.className='candy'+(v===-1?' empty':'')+(selected===i?' selected':'');b.textContent=v<0?'':candies[v];b.setAttribute('aria-label',v<0?'kosong':candies[v]);b.onclick=()=>tap(i);el.appendChild(b)});update()}
function update(){$('level').textContent=level;$('score').textContent=score;$('moves').textContent=moves;$('stars').textContent=stars;$('targetText').textContent=`Raih ${target()} poin! (${Math.min(score,target())}/${target()})`;$('bar').style.width=Math.min(100,score/target()*100)+'%';if(score>=target()&&!answered&&!locked)showQuiz();if(moves<=0&&score<target()&&!locked){$('message').textContent='Langkah habis! Ulangi level untuk mencoba lagi.';$('shuffle').disabled=true}}
function tap(i){if(locked||moves<=0||answered)return;if(selected===null){selected=i;render();return}if(selected===i){selected=null;render();return}let a=selected,b=i;selected=null;let adjacent=Math.abs(a-b)===SIZE||(Math.floor(a/SIZE)===Math.floor(b/SIZE)&&Math.abs(a-b)===1);if(!adjacent){selected=b;render();return}[board[a],board[b]]=[board[b],board[a]];let m=findMatches();if(m.size){moves--;clearMatches(m);$('message').textContent='Hebat! Permen cocok dan poin bertambah ✨'}else{[board[a],board[b]]=[board[b],board[a]];$('message').textContent='Belum cocok. Coba tukar permen yang lain!'}render()}
function findMatches(){let s=new Set();for(let r=0;r<SIZE;r++)for(let c=0;c<SIZE;c++){let i=r*SIZE+c,v=board[i];if(v<0)continue;let run=[i];for(let x=c+1;x<SIZE&&board[r*SIZE+x]===v;x++)run.push(r*SIZE+x);if(run.length>=3)run.forEach(n=>s.add(n));run=[i];for(let y=r+1;y<SIZE&&board[y*SIZE+c]===v;y++)run.push(y*SIZE+c);if(run.length>=3)run.forEach(n=>s.add(n))}return s}
function clearMatches(s){score+=s.size*10;s.forEach(i=>board[i]=-1);for(let c=0;c<SIZE;c++){let vals=[];for(let r=SIZE-1;r>=0;r--){let v=board[r*SIZE+c];if(v>=0)vals.push(v)}while(vals.length<SIZE)vals.push(rand());for(let r=SIZE-1,j=0;r>=0;r--,j++)board[r*SIZE+c]=vals[j]}let more=findMatches();if(more.size)clearMatches(more)}
function showQuiz(){locked=true;$('quiz').classList.add('show');let q=questions[(level-1)%questions.length];$('question').textContent=q.q;$('options').innerHTML='';$('result').textContent='';$('next').style.display='none';q.a.forEach((ans,i)=>{let b=document.createElement('button');b.className='option';b.textContent=String.fromCharCode(65+i)+'. '+ans;b.onclick=()=>answer(i,q.c);$('options').appendChild(b)});$('message').textContent='Target tercapai! Jawab soal SKI untuk naik level.';$('quiz').scrollIntoView({behavior:'smooth',block:'nearest'})}
function answer(choice,correct){let opts=[...$('options').children];opts.forEach((b,i)=>{b.disabled=true;if(i===correct)b.classList.add('correct');if(i===choice&&i!==correct)b.classList.add('wrong')});if(choice===correct){answered=true;stars++;$('result').textContent='Benar! Kamu mendapat 1 bintang. 🌟';$('next').style.display='block'}else{$('result').textContent='Belum tepat. Pelajari jawaban hijau, lalu coba lagi!';let retry=document.createElement('button');retry.className='action secondary';retry.textContent='Coba soal lagi';retry.style.width='100%';retry.onclick=()=>{retry.remove();locked=false;showQuiz()};$('options').after(retry)}update()}
$('next').onclick=()=>{level++;score=0;moves=20;answered=false;locked=false;$('quiz').classList.remove('show');$('message').textContent='Level baru dimulai! Target poin semakin tinggi.';$('shuffle').disabled=false;createBoard()};
$('shuffle').onclick=()=>{if(locked||moves<=0||answered)return;moves--;board.sort(()=>Math.random()-.5);selected=null;render();$('message').textContent='Papan diacak. Semangat! 🍀'};
$('restart').onclick=()=>{score=0;moves=20;answered=false;locked=false;$('quiz').classList.remove('show');$('shuffle').disabled=false;$('message').textContent='Level diulang. Kamu pasti bisa!';createBoard()};
createBoard();
</script></body></html>
